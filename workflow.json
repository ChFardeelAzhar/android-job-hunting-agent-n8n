    {
      "parameters": {
        "jsCode": "const today = new Date().toISOString().split('T')[0];\nconst items = $input.all();\n\nconst todayJobs = items.filter(item => item.json.date === today);\n\nconst highMatches = todayJobs.filter(j => j.json.matchScore >= 70);\nconst manualReview = todayJobs.filter(j => j.json.matchScore >= 60 && j.json.matchScore < 70);\n\nreturn [{\n  totalScanned: todayJobs.length,\n  highMatches: highMatches.length,\n  manualReviewCount: manualReview.length,\n  highMatchList: highMatches.map(j => ({\n    company: j.json.company,\n    title: j.json.jobTitle,\n    score: j.json.matchScore,\n    link: j.json.jobLink,\n    coverLetter: j.json.coverLetter\n  })),\n  manualReviewList: manualReview.map(j => ({\n    company: j.json.company,\n    title: j.json.jobTitle,\n    score: j.json.matchScore,\n    link: j.json.jobLink\n  }))\n}];"
      },
      "id": "1e552d08-b2be-4ac9-a6e1-50bd752c580a",
      "name": "Filter Today Jobs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        688,
        1264
      ]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nlet html = '<h1>Daily Job Hunt Summary - ' + new Date().toLocaleDateString() + '</h1>';\n\nhtml += '<h2>Overview</h2>';\nhtml += '<ul>';\nhtml += '<li><strong>Total Jobs Scanned:</strong> ' + data.totalScanned + '</li>';\nhtml += '<li><strong>High Matches (70%+):</strong> ' + data.highMatches + '</li>';\nhtml += '<li><strong>Manual Review (60-69%):</strong> ' + data.manualReviewCount + '</li>';\nhtml += '</ul>';\n\nif (data.highMatches > 0) {\n  html += '<h2>🎯 High Match Jobs (70%+)</h2>';\n  for (const job of data.highMatchList) {\n    html += '<div style=\"border: 1px solid #ddd; padding: 15px; margin: 10px 0; background: #f9f9f9;\">';\n    html += '<h3>' + job.company + ' - ' + job.title + '</h3>';\n    html += '<p><strong>Match Score:</strong> ' + job.score + '%</p>';\n    html += '<p><strong>Link:</strong> <a href=\"' + job.link + '\">' + job.link + '</a></p>';\n    html += '<details><summary>View Cover Letter</summary><pre>' + job.coverLetter + '</pre></details>';\n    html += '</div>';\n  }\n}\n\nif (data.manualReviewCount > 0) {\n  html += '<h2>⚠️ Manual Review Required (60-69%)</h2>';\n  for (const job of data.manualReviewList) {\n    html += '<div style=\"border: 1px solid #ffa500; padding: 15px; margin: 10px 0; background: #fff8e1;\">';\n    html += '<h3>' + job.company + ' - ' + job.title + '</h3>';\n    html += '<p><strong>Match Score:</strong> ' + job.score + '%</p>';\n    html += '<p><strong>Link:</strong> <a href=\"' + job.link + '\">' + job.link + '</a></p>';\n    html += '</div>';\n  }\n}\n\nif (data.highMatches === 0 && data.manualReviewCount === 0) {\n  html += '<p><em>No matches found today. The search will continue tomorrow.</em></p>';\n}\n\nreturn [{ html, subject: 'Daily Job Hunt Summary - ' + data.totalScanned + ' jobs scanned, ' + data.highMatches + ' matches' }];"
      },
