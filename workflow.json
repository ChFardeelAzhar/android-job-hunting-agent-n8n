      "parameters": {
        "jsCode": "const queries = [\n  'Android Developer Kotlin remote job hiring 2025',\n  'Jetpack Compose developer remote position',\n];\n\nreturn queries.map(q => ({ query: q }));"
      },
      "id": "098c0a58-d298-41d6-a058-a8fa43207a16",
      "name": "Set All Queries",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        464,
