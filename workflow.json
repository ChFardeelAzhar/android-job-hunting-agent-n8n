        "message": "=<h2>New Job Match Found!</h2>\n<p><strong>Company:</strong> {{ $('Combine Job and Score').item.json.company }}</p>\n<p><strong>Position:</strong> {{ $('Combine Job and Score').item.json.jobTitle }}</p>\n<p><strong>Match Score:</strong> {{ $('Combine Job and Score').item.json.matchScore }}%</p>\n<p><strong>Job Link:</strong> <a href=\"{{ $('Combine Job and Score').item.json.jobLink }}\">{{ $('Combine Job and Score').item.json.jobLink }}</a></p>\n<h3>Score Breakdown:</h3>\n<p>{{ $('Combine Job and Score').item.json.scoreReasoning }}</p>\n<h3>Your Custom Cover Letter:</h3>\n<div style=\"background: #f5f5f5; padding: 15px; border-left: 4px solid #4CAF50;\">\n{{ $json.coverLetter }}\n</div>\n<h3>Application Instructions:</h3>\n<ol>\n<li>Review the job posting at the link above</li>\n<li>Customize the cover letter if needed</li>\n<li>Submit your application with your resume</li>\n<li>Update the status in the tracking sheet</li>\n</ol>\n<p><em>This email was sent automatically by your job hunting workflow.</em></p>",
