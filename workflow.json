    {
      "parameters": {
        "promptType": "define",
        "text": "=Search Google for: {{ $json.query }}\n\nFind 3 recent job postings. For each job, extract:\n- Company name\n- Job title\n- Job description (full text)\n- Location (Remote/Lahore/Other)\n- Experience required\n- Required skills (especially Kotlin, Jetpack Compose, Android)\n- Job link/URL (use actual URL from search result, or LinkedIn jobs URL if not available)\n\nReturn results as a structured list.",
        "options": {
          "systemMessage": "You are a job search assistant. Search Google ONCE for the given query. Extract exactly 3 job postings and return immediately. Do not search more than 3 times. Keep response brief. For job links, use the actual URL from search results. If no URL found, construct it as: https://www.linkedin.com/jobs/search/?keywords=Android+Developer+Kotlin",
          "maxIterations": 20,
          "returnIntermediateSteps": false
        }
      },
      "id": "d5585c09-d7cc-404c-9765-45011b3d5b72",
      "name": "Job Search Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        720,
        528
      ]
    },
    {
      "parameters": {
        "options": {
          "gl": "us",
          "device": "desktop",
          "no_cache": false,
          "google_domain": "google.com",
          "hl": "en"
        }
      },
      "id": "ca8e7162-cb8f-4a9b-b2f4-d7fcb70e0b2f",
      "name": "Google Search Tool",
      "type": "@n8n/n8n-nodes-langchain.toolSerpApi",
      "typeVersion": 1,
      "position": [
        864,
        752
      ],
      "credentials": {
        "serpApi": {
          "id": "j1EJobBleIrgOsKt",
          "name": "SerpAPI account 4"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const allJobs = [];\nconst items = $input.all();\n\nfor (const item of items) {\n  const searchResults = item.json.output || '';\n  const query = item.json.query || '';\n  \n  // Simple parsing - in production, this would be more robust\n  const jobMatches = searchResults.match(/\\d+\\..+?(?=\\d+\\.|$)/gs) || [];\n  \n  for (const jobText of jobMatches) {\n    const companyMatch = jobText.match(/Company:\\s*([^\\n*-]+)/);\n    const titleMatch = jobText.match(/Title:\\s*([^-]+)/);\n    const locationMatch = jobText.match(/(?:Remote|Lahore|Location:\\s*)([^-]+)/);\n    const experienceMatch = jobText.match(/(\\d+-\\d+)\\s*years/);\n    const skillsMatch = jobText.match(/(?:Kotlin|Jetpack Compose|MVVM|Android)[^-]*/);\n    const linkMatch = jobText.match(/https?:\\/\\/[^\\s]+/);\n    \n    allJobs.push({\n      company: companyMatch ? companyMatch[1].trim() : 'Unknown Company',\n      jobTitle: titleMatch ? titleMatch[1].trim() : 'Android Developer',\n      description: jobText,\n      location: locationMatch ? locationMatch[1].trim() : 'Remote',\n      experience: experienceMatch ? experienceMatch[1] : '1-3',\n      skills: skillsMatch ? skillsMatch[0] : 'Kotlin, Android',\njobLink: linkMatch ? linkMatch[0] : `https://www.google.com/search?q=${encodeURIComponent(query)}+android+developer+job`,      education: 'BS Computer Science or equivalent',\n      searchQuery: query\n    });\n  }\n}\n\nreturn allJobs.slice(0, 20);"
      },
      "id": "338dc843-f2d5-4496-9f88-ae669ec0ee1a",
      "name": "Parse Job Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1088,
        528
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Score this job for Fardeel Azhar (Android Developer with 1.5 years professional experience):\n\nJob Details:\nCompany: {{ $json.company }}\nTitle: {{ $json.jobTitle }}\nDescription: {{ $json.description }}\nLocation: {{ $json.location }}\nExperience Required: {{ $json.experience }} years\nSkills: {{ $json.skills }}\nEducation: {{ $json.education }}\n\nCandidate Profile:\n- Experience: 1.5 years professional + 3 years overall Android development\n- Skills: Kotlin, Jetpack Compose, Clean Architecture, MVVM, Multi-module, Retrofit, GraphQL Apollo, Room, Firebase, Dagger Hilt, Coroutines, Flow\n- Location Preference: Remote (Foreign companies first), Lahore second\n- Education: BS Software Engineering (in progress, 2025-2029)\n- Achievement: Contributed to 5M+ downloads app with 4.4 rating\n\nScoring Criteria:\n1. Kotlin + Jetpack Compose skills match (40 points max)\n2. Experience level match 1-3 years (25 points max)\n3. Remote or Lahore location match (20 points max)\n4. Education requirement match (15 points max)\n\nProvide:\n- matchScore (total out of 100)\n- skillsScore (out of 40)\n- experienceScore (out of 25)\n- locationScore (out of 20)\n- educationScore (out of 15)\n- reasoning (brief explanation)",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a job matching expert. Score jobs based on the candidate profile and criteria provided. Be objective and precise.",
          "maxIterations": 5
        }
      },
      "id": "500906c4-f8de-4541-879b-555753278a28",
      "name": "Job Scoring Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1328,
        528
      ]
    },
